<?xml version="1.0" encoding="UTF-8"?>
<!--
  Excel content add-in: embeds the live Prospect Heat Map (GitHub Pages) as a
  resizable frame inside a workbook sheet.

  Install on this Mac (one-time, from Terminal):
    mkdir -p ~/Library/Containers/com.microsoft.Excel/Data/Documents/wef
    cp ~/prospect-heatmap/excel-manifest.xml ~/Library/Containers/com.microsoft.Excel/Data/Documents/wef/
  Then restart Excel -> Insert tab -> Add-ins (My Add-ins dropdown) ->
  "Developer Add-ins" -> Prospect Heat Map. Drop it on a blank sheet named "Map"
  and resize. It saves with the workbook.

  Needs internet (it IS the live site). Statuses/notes logged inside Excel's
  frame use Excel's own browser storage - separate from Safari/Chrome until
  Supabase sync is provisioned (supabase/README.md), which merges them.
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="ContentApp">
  <Id>ea3d5f5d-d301-4a71-841a-e086da59b3f9</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Conor Kain</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Prospect Heat Map"/>
  <Description DefaultValue="Live CT/Westchester prospecting heat map - fit scores, researched prospects, new-opening alerts."/>
  <IconUrl DefaultValue="https://ckaiin.github.io/prospect-heatmap/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://ckaiin.github.io/prospect-heatmap/icon-64.png"/>
  <SupportUrl DefaultValue="https://github.com/ckaiin/prospect-heatmap"/>
  <AppDomains>
    <AppDomain>https://ckaiin.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://ckaiin.github.io/prospect-heatmap/index.html"/>
    <RequestedWidth>960</RequestedWidth>
    <RequestedHeight>640</RequestedHeight>
  </DefaultSettings>
  <Permissions>ReadDocument</Permissions>
</OfficeApp>
